<?xml version="1.0"?>
<!--
  Eyas pilot station: makes FlightGear publish joystick 0's raw axes and
  buttons under /devices/status/joysticks/joystick[0], which eyas_ctrl.xml
  sends to the station for its fg input (examples/pilot_station, D-044).
  It replaces FlightGear's own bindings for that device while it is loaded:
  with the null FDM they fly nothing anyway. Load it with the config option
  (see examples/README.md); it is not a file for Input/Joysticks.
-->
<PropertyList>
 <input>
  <joysticks>
   <js n="0">
    <axis n="0">
     <desc>Eyas raw axis 0</desc>
     <binding>
      <command>property-scale</command>
      <property>/devices/status/joysticks/joystick[0]/axis[0]</property>
      <factor type="double">1</factor>
      <offset type="double">0</offset>
     </binding>
    </axis>
    <axis n="1">
     <desc>Eyas raw axis 1</desc>
     <binding>

<?xml version="1.0"?>
<!--
  Eyas pilot station: the pose Eyas sends FlightGear, which runs with the null FDM (examples/pilot_station, D-044).
  Copy into $FG_ROOT/Protocol/ and run FlightGear as examples/README.md shows.
  The field order must match encode_fdm() in fg_link.cpp.
-->
<PropertyList>
 <generic>
  <input>
   <line_separator>newline</line_separator>
   <var_separator>,</var_separator>
   <chunk>
    <name>latitude</name>
    <type>double</type>
    <node>/position/latitude-deg</node>
   </chunk>
   <chunk>
    <name>longitude</name>
    <type>double</type>
    <node>/position/longitude-deg</node>
   </chunk>
   <chunk>
    <name>altitude</name>
    <type>double</type>
    <node>/position/altitude-ft</node>
   </chunk>
   <chunk>
    <name>roll</name>
    <type>double</type>
    <node>/orientation/roll-deg</node>
   </chunk>
   <chunk>
    <name>pitch</name>
    <type>double</type>
    <node>/orientation/pitch-deg</node>
   </chunk>
   <chunk>
    <name>heading</name>
    <type>double</type>
    <node>/orientation/heading-deg</node>
   </chunk>
   <chunk>
    <name>roll rate</name>
    <type>double</type>
    <node>/orientation/roll-rate-degps</node>
   </chunk>
   <chunk>
    <name>pitch rate</name>
    <type>double</type>
    <node>/orientation/pitch-rate-degps</node>
   </chunk>
   <chunk>
    <name>yaw rate</name>
    <type>double</type>
    <node>/orientation/yaw-rate-degps</node>
   </chunk>
   <chunk>
    <name>airspeed</name>
    <type>double</type>
    <node>/velocities/airspeed-kt</node>
   </chunk>
   <chunk>
    <name>vertical speed</name>
    <type>double</type>
    <node>/velocities/vertical-speed-fps</node>
   </chunk>
   <chunk>
    <name>u body</name>
    <type>double</type>
    <node>/velocities/uBody-fps</node>
   </chunk>
   <chunk>
    <name>v body</name>
    <type>double</type>
    <node>/velocities/vBody-fps</node>
   </chunk>
   <chunk>
    <name>w body</name>
    <type>double</type>
    <node>/velocities/wBody-fps</node>
   </chunk>
   <chunk>
    <name>speed north</name>
    <type>double</type>
    <node>/velocities/speed-north-fps</node>
   </chunk>
   <chunk>
    <name>speed east</name>
    <type>double</type>
    <node>/velocities/speed-east-fps</node>
   </chunk>
   <chunk>
    <name>speed down</name>
    <type>double</type>
    <node>/velocities/speed-down-fps</node>
   </chunk>
   <chunk>
    <name>sideslip</name>
    <type>double</type>
    <node>/orientation/side-slip-deg</node>
   </chunk>
   <chunk>
    <name>alpha</name>
    <type>double</type>
    <node>/orientation/alpha-deg</node>
   </chunk>
   <chunk>
    <name>main rotor azimuth</name>
    <type>double</type>
    <node>/rotors/main/blade[0]/position-deg</node>
   </chunk>
   <chunk>
    <name>tail rotor azimuth</name>
    <type>double</type>
    <node>/rotors/tail/blade[0]/position-deg</node>
   </chunk>
   <chunk>
    <name>weight on wheels</name>
    <type>bool</type>
    <node>/gear/gear[0]/wow</node>
   </chunk>
  </input>
 </generic>
</PropertyList>

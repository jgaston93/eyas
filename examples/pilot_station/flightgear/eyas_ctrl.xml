<?xml version="1.0"?>
<!--
  Eyas pilot station: the raw axes and buttons of FlightGear's joystick[0], sent to the station for its fg input (examples/pilot_station, D-044).
  Copy into $FG_ROOT/Protocol/ and run FlightGear as examples/README.md shows.
  The field order must match parse_ctrl() in fg_link.cpp.
-->
<PropertyList>
 <generic>
  <output>
   <line_separator>newline</line_separator>
   <var_separator>,</var_separator>
   <chunk>
    <name>axis 0</name>
    <type>float</type>
    <format>%f</format>
    <node>/devices/status/joysticks/joystick[0]/axis[0]</node>
   </chunk>
   <chunk>
    <name>axis 1</name>
    <type>float</type>
    <format>%f</format>
    <node>/devices/status/joysticks/joystick[0]/axis[1]</node>
   </chunk>
